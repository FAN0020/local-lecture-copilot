# Copy to ~/.config/local-lecture-copilot/windows-vm.env so every worktree
# uses the same machine-local VM connection. A repo-local .windows-vm.env is
# also supported as an ignored fallback.
# Passwords and credentials must not be stored here; the bridge uses a dedicated SSH key.
WINDOWS_VM_HOST=192.168.64.10
WINDOWS_VM_USER=YourWindowsUser
WINDOWS_VM_PORT=22
WINDOWS_VM_NAME="Windows 11 ARM"
# Optional overrides:
# The default key is ~/.local/share/local-lecture-copilot/windows-vm/id_ed25519.
# WINDOWS_VM_IDENTITY_FILE=/absolute/path/to/a/dedicated/private/key
# WINDOWS_VM_BOOT_TIMEOUT=180
