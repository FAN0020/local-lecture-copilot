# Optional. Defaults shown.
PORT=4318
LECTURE_COPILOT_DATA=./.lecture-copilot
# Optional stable settings file used to remember a changed workspace location.
LECTURE_COPILOT_SETTINGS=./.lecture-copilot-config.json
WHISPER_BIN=whisper
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
# Optional translation tuning/profiling. Translation starts on demand.
# Translation requests are bounded to one per session by default.
LECTURE_COPILOT_TRANSLATION_CONCURRENCY=1
# All Whisper stages share one process slot and at most eight queued file jobs.
LECTURE_COPILOT_STT_QUEUE_LIMIT=8
LECTURE_COPILOT_STT_TIMEOUT_MS=600000
# All Ollama features share this process-wide active/queued budget.
LECTURE_COPILOT_LLM_CONCURRENCY=1
LECTURE_COPILOT_LLM_QUEUE_LIMIT=16
LECTURE_COPILOT_OLLAMA_TIMEOUT_MS=120000
# Ollama 0.33 uses a process-local prompt cache. Recycle the runner after the
# first threshold reached so one-shot lecture translations cannot fill it.
LECTURE_COPILOT_OLLAMA_RECYCLE_REQUESTS=25
LECTURE_COPILOT_OLLAMA_RUNNER_MAX_AGE_MS=300000
# Keep the model warm for a short manual burst, then release idle memory.
# Continuous work is still bounded by the recycle policy above.
LECTURE_COPILOT_OLLAMA_KEEP_ALIVE=1m
# CPU inference threads, capped to available CPU parallelism. This does not
# restrict GPU inference; increase it if you prefer throughput to responsiveness.
LECTURE_COPILOT_OLLAMA_THREADS=4
# Set to 1 to expose /api/debug/translation-metrics with an in-memory trace.
LECTURE_COPILOT_TRANSLATION_DEBUG=0
# Set to 1 for concise 10-second main/renderer queue and memory diagnostics.
LECTURE_COPILOT_RUNTIME_DEBUG=0
